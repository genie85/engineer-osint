 and 153rd Engineer Battalions.","what_it_does_not_prove_cs":"Neurčuje přesně, které roty, osoby a materiál byly převedeny, ani úplnou předchozí/následnou TO&E.","what_it_does_not_prove_en":"Does not specify exactly which companies, personnel or equipment transferred, nor complete before/after TO&E.","confidence":"HIGH_FOR_SOURCE_WORDING"}],"external_leads":[{"external_id":"MILITARYLAND:1226th-engineering-battalion","topic":"1226th Separate Engineer Battalion / 20th Army Corps","status":"EXTERNAL_LEAD","verification_status":"SECONDARY_ONLY_NEEDS_PRIMARY_CONFIRMATION","canonicalization":"NOT_CANONICALIZED"},{"external_id":"MILITARYLAND:1222nd-support-battalion","topic":"1222nd Separate Engineer Battalion / 16th Army Corps","status":"EXTERNAL_LEAD","verification_status":"SECONDARY_ONLY_NEEDS_PRIMARY_CONFIRMATION","canonicalization":"NOT_CANONICALIZED"},{"external_id":"MILITARYLAND:azov-engineer-battalion","topic":"Engineer Battalion / 12th Special Purpose Brigade Azov","status":"EXTERNAL_LEAD","verification_status":"SECONDARY_ONLY_NEEDS_PRIMARY_CONFIRMATION","canonicalization":"NOT_CANONICALIZED"}],"observed_minimum_updates":[{"entity_id":"ENG-TECH-0024","status":"UNCHANGED_REVIEWED","value_as_of":"2021-04-15","current_value_status":"CURRENT_UNKNOWN"}],"orbat_updates":[{"entity_id":"ENG-UNIT-0030","status":"CURRENT_PUBLIC_PROFILE_CONFIRMED","subordinate_ids":["ENG-UNIT-0031","ENG-UNIT-0032","ENG-UNIT-0033"],"source_ids":["ENG-SRC-0269"]},{"entity_id":"ENG-UNIT-0032","status":"HISTORICAL_LINEAGE_PRESERVED","event_date":"2020-01-01","source_ids":["ENG-SRC-0272"]}],"historical_coverage":{"version":"2026-08-17-B31","rows":[{"country":"CZE","capability":"ORGANIZATION","period":"2020-2026","coverage":"MEDIUM_HIGH","basis":"Current official profiles + B30 organizational lineage"},{"country":"CZE","capability":"EOD_CIED","period":"2010-2019","coverage":"MEDIUM","basis":"Historical C-IED/RCP evidence exists; systematic backfill remains incomplete"},{"country":"CZE","capability