  "historicalWorkflow": "name: ENGINEER OSINT authorized canonical executor\n\non:\n  pull_request:\n    branches: [main]\n    types: [opened, synchronize, reopened]\n    paths:\n      - 'docs/engineer-osint/canonical-execution-requests/*.json'\n\npermissions:\n  contents: write\n  pull-requests: read\n\nconcurrency:\n  group: engineer-osint-canonical-executor-${{ github.event.pull_request.number }}\n  cancel-in-progress: false\n\njobs:\n  execute:\n    if: github.event.pull_request.head.repo.full_name == github.repository\n    runs-on: ubuntu-latest\n    steps:\n      - name: Checkout exact same-repository PR head\n        uses: actions/checkout@v5\n        with:\n          ref: ${{ github.event.pull_request.head.sha }}\n          fetch-depth: 0\n      - name: Setup Node\n        uses: actions/setup-node@v5\n        with:\n          node-version: '24'\n      - name: Resolve isolated execution request\n        id: request\n        shell: bash\n        env:\n          BASE_SHA: ${{ github.event.pull_request.base.sha }}\n        run: |\n          set -euo pipefail\n          mapfile -t requests < <(git diff --name-only \"${BASE_SHA}...HEAD\" -- 'docs/engineer-osint/canonical-execution-requests/*.json')\n          if [ \"${#requests[@]}\" -ne 1 ]; then\n            printf 'Expected exactly one canonical execution request, found %s\\n' \"${#requests[@]}\" >&2\n            exit 1\n          fi\n          printf 'path=%s\\n' \"${requests[0]}\" >> \"$GITHUB_OUTPUT\"\n      - name: Execute exact authorized canonical request to PR head only\n        env:\n          GITHUB_EVENT_NAME: ${{ github.event_name }}\n          GITHUB_EVENT_PATH: ${{ github.event_path }}\n          GITHUB_REPOSITORY: ${{ github.repository }}\n        run: node docs/engineer-osint/authorized-canonical-executor.mjs '${{ steps.request.outputs.path }}' --execute\n"
}
